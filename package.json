{
  "name": "cantill-procurement",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "cli": "node --import tsx packages/cli/src/main.ts",
    "verify:kit": "vitest run --config vitest.private.config.ts",
    "start": "node dist/server.js",
    "build": "esbuild apps/api/src/server.ts --bundle --platform=node --format=esm --target=node22 --packages=external --alias:@cantill/engine=./packages/engine/src/index.ts --outfile=dist/server.js",
    "dev": "node --import tsx apps/api/src/server.ts",
    "check:gemini": "node --import tsx scripts/check-gemini.ts",
    "verify:local": "node --import tsx scripts/verify-local.ts",
    "verify:supabase": "node --import tsx scripts/verify-supabase.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@fastify/static": "^10.1.11",
    "@google/genai": "^3.4.0",
    "csv-parse": "^7.0.3",
    "csv-stringify": "^6.6.0",
    "decimal.js": "^10.6.0",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "luxon": "^3.7.2",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@types/luxon": "^3.7.1",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "prettier": "^3.10.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.8",
    "vitest": "^4.1.12"
  }
}
